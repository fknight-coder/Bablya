clc; clear; close all;

t = input('Enter time vector t (symmetric, e.g. -3:3): ');
x = input('Enter x(t) (same length as t, e.g. [1 2 3 4 5 6 7]): ');



%% Even and odd decomposition
x_neg  = fliplr(x);              % x(-t)
x_even = (x + x_neg) / 2;        % xe(t) = [x(t) + x(-t)] / 2
x_odd  = (x - x_neg) / 2;        % xo(t) = [x(t) - x(-t)] / 2

fprintf('\nEven Component:\n');  disp(x_even);
fprintf('\nOdd Component:\n');   disp(x_odd);


%% Plots
figure;
subplot(3,1,1);
stem(t, x, 'LineWidth', 1.2); grid on;
title('Original Signal'); xlabel('t'); ylabel('x(t)');

subplot(3,1,2);
stem(t, x_even, 'LineWidth', 1.2); grid on;
title('Even Component'); xlabel('t'); ylabel('x_e(t)');

subplot(3,1,3);
stem(t, x_odd, 'LineWidth', 1.2); grid on;
title('Odd Component'); xlabel('t'); ylabel('x_o(t)');
