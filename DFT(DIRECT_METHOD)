x = input("Enter x(n)");
N = length(x);
X = zeros(1,N);
for k = 0:N-1
    for n = 0:N-1
        X(k+1)=X(k+1)+x(n+1)*exp(-1j*2*pi*k*n/N);
    end
end
mag = abs(X);
phase = angle(X);
disp('DFT X(k)');
disp(X);
disp('Magnitude of DFT');
disp(mag);
disp('Phase of DFT');
disp(phase);
disp('Phase in degree');
disp(rad2deg(phase));
n = 0:N-1;
k = 0:N-1;
subplot (3,1,1);
stem(k,x,'LineWidth',1.5);
title('input signal');
grid on; 
subplot (3,1,2);
stem(k,mag,'LineWidth',1.5);
title('input signal');
grid on;
subplot (3,1,3);
stem(k,rad2deg(phase),'LineWidth',1.5);
title('input signal');
grid on;
