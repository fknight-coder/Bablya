n = -10:10;
impulse = (n==0);
step = (n>=0);
alpha = -0.5;
exponential = exp(alpha*n);
ramp = n.*(n>=0);
sinc_signal = sinc(n);
rectangular = (abs(n)<=1);
figure;
subplot (3,2,1);
stem (n,impulse,'LineWidth',2);
title('impulse');
xlabel('time');
ylabel('Amplitude');
grid on;
subplot (3,2,2);
stem(n,step,'LineWidth',2);
title('step');
xlabel('time');
ylabel('Amplitude');
grid on;
subplot (3,2,3);
stem (n,exponential,'LineWidth',2);
title('impulse');
xlabel('time');
ylabel('Amplitude');
grid on;
subplot (3,2,4);
stem (n,rectangular,'LineWidth',2);
title('rectangular');
xlabel('time');
ylabel('Amplitude');
grid on;
subplot (3,2,5);
stem (n,sinc_signal,'LineWidth',2);
title('sinc_signal');
xlabel('time');
ylabel('Amplitude');
grid on;
subplot (3,2,6);
stem (n,ramp,'LineWidth',2);
title('ramp');
xlabel('time');
ylabel('Amplitude');
grid on;
