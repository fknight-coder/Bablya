tau = -5:0.01:5;
u = @(t) double(t>=0);
t = 2;
x = u(tau);
h = u(tau);
h_reverse = u(-tau);
h_shift = u (t - tau);
product = x.*h_shift;
y = tau.*u(tau);
figure;
subplot(6,1,1);
plot(tau,x,'LineWidth',1.5);
grid on ;
ylabel('x(\tau)');
title('1.x(\tau) = u(\tau)');
subplot(6,1,2);
plot(tau,h,'LineWidth',1.5);
grid on ;
ylabel('h(\tau)');
title('1.h(\tau) = u(\tau)');
subplot(6,1,3);
plot(tau,h_reverse,'LineWidth',1.5);
grid on ;
ylabel('h(-\tau)');
title('2.h(-\tau) = u(-\tau)');
subplot(6,1,4);
plot(tau,h_shift,'LineWidth',1.5);
grid on ;
ylabel('h(t-\tau)');
title('1.h(t-\tau),t = 2');
subplot(6,1,5);
plot(tau,product,'LineWidth',1.5);
grid on ;
ylabel('Product');
title('5.x(\tau)h(t-\tau)');
subplot(6,1,6);
plot(tau,y,'LineWidth',1.5);
grid on ;
xlabel('t')
ylabel('y(t)');
title('6.y(t)= x(t)*h(t)= tu(t)');
