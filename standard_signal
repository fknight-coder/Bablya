t = -5:0.01:5;
impulse = (t==0);
step = (t>=0);
alpha = -0.5;
exponential = exp(alpha*t);
ramp = t.*(t>=0);
sinc_signal = sinc(t);
rectangular = (abs(t)<=1);
figure;
subplot (3,2,1);
plot (t,impulse,'LineWidth',2);
title('impulse');
xlabel('time');
ylabel('Amplitude');
grid on;
subplot (3,2,2);
plot (t,step,'LineWidth',2);
title('step');
xlabel('time');
ylabel('Amplitude');
grid on;
subplot (3,2,3);
plot (t,exponential,'LineWidth',2);
title('impulse');
xlabel('time');
ylabel('Amplitude');
grid on;
subplot (3,2,4);
plot (t,rectangular,'LineWidth',2);
title('rectangular');
xlabel('time');
ylabel('Amplitude');
grid on;
subplot (3,2,5);
plot (t,sinc_signal,'LineWidth',2);
title('sinc_signal');
xlabel('time');
ylabel('Amplitude');
grid on;
subplot (3,2,6);
plot (t,ramp,'LineWidth',2);
title('ramp');
xlabel('time');
ylabel('Amplitude');
grid on;
